    "listhen": "^1.10.1",
    "mongoose": "^9.9.2",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  }
}

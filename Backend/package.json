{
  "name": "untangled-it-solutions-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Untangled IT Solutions Backend API (merged production entry)",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:working": "tsx server/index-working-v2.ts",
    "dev:desktop": "tsx server/index-desktop.ts",
    "start": "tsx server/index.ts",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:watch": "node --test --watch \"tests/*.test.mjs\"",

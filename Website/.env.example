# Development: browser /api requests go to the existing Node Website backend.
VITE_API_URL=/api
WEBSITE_API_PROXY_TARGET=http://localhost:5001

# To use a deployed Node backend in development, set WEBSITE_API_PROXY_TARGET
# to its origin (without /api). Do not use the dedicated Nexus FastAPI URL.

# Production: configure the Website host to forward /api to the Node backend,
# or set VITE_API_URL to the confirmed Node backend URL ending in /api before
# building. Direct browser access needs the Website origin in Node CORS_ORIGINS.
# WEBSITE_API_PROXY_TARGET only configures the Vite development server.

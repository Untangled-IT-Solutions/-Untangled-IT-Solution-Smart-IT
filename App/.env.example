# Untangled Nexus Desktop – example configuration
# Copy to .env for local overrides. NEVER commit .env.

# Production (default): dedicated Nexus FastAPI backend, never the Website Node API
API_BASE_URL=https://untangled-nexus-api.onrender.com

# Use "development" only on developer machines (allows localhost)
ENVIRONMENT=production
APP_CHANNEL=production

# Developer-only local API (used when ENVIRONMENT=development and API_BASE_URL is unset)
# API_BASE_URL=http://localhost:10000

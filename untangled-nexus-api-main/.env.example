# Dedicated Nexus FastAPI service only. Never copy these settings to App.
# Configure the real value in server secrets or an ignored local .env file.
MONGODB_URI=
MONGODB_DB=untangled_its
PORT=10000
# Optional explicit browser origins if this API later serves browser clients.
FRONTEND_URL=*
DASHBOARD_CACHE_MS=15000

# Nexus session and private document limits
SESSION_EXPIRY_HOURS=8
MAX_DOCUMENT_BYTES=8388608
# Set only according to your approved sick-leave documentation policy.
SICK_LEAVE_DOCUMENT_REQUIRED=false

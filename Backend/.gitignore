.env.test.local
.env.production.local

# Build output
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp

# IDE files
.vscode/
.idea/
*.iml
*.sublime-*
.vscode/settings.json
.vscode/launch.json

# Testing
coverage/
.nyc_output/

# Database files
*.db
*.sqlite
*.sqlite3

# MongoDB data
mongodb-data/
dump/
*.dump

# SSL certificates
*.pem
*.key
*.crt
*.cert

# Misc
.ftpconfig
.vscode/launch.json
.env
.env.*
!/.env.example

# Server specific
server/__pycache__/

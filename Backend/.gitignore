server/.pytest_cache/

# Production
*.min.js
*.min.css

# Temporary files
tmp/
temp/
*.tmp
*.temp


# Python virtual environment
Work/.venv/
Work/venv/
Work/env/

# Python cache
Work/__pycache__/
Work/*.pyc
Work/*.pyo

# Environment variables
Work/.env
Work/.env.local

# IDE files
Work/.vscode/
Work/.idea/

# Logs and temporary files
Work/logs/
Work/*.log
Work/tmp/
Work/temp/

# Output directories
Work/dist/
Work/build/
Work/*.egg-info/
# Copy these entries into .env. Never commit the real SMTP password.
NEXUS_EMAIL_ENABLED=false
NEXUS_SMTP_HOST=smtp.office365.com
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=notifications@untangledits.co.za
NEXUS_SMTP_PASSWORD=replace-with-an-app-password-or-secret
NEXUS_SMTP_FROM=notifications@untangledits.co.za
NEXUS_SMTP_USE_TLS=true

# Attendance uses a local one-second clock and checks the server periodically.
NEXUS_ATTENDANCE_SYNC_SECONDS=60
NEXUS_API_DEBUG=false

# AI Meeting Notes. Keep the real key only in .env and never commit it.
OPENAI_API_KEY=replace-with-your-private-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MEETING_NOTES_MODEL=gpt-5.4-mini
